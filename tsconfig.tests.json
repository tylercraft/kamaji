{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "types": ["node"],
    "allowImportingTsExtensions": false
  },
  "include": ["packages/*/src/**/*.test.ts", "packages/*/src/**/*.test.tsx", "vitest.config.ts"]
}
