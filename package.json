{
  "name": "kamaji",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/guard.mjs build && tsc -b && npm run build -w @kamaji/web && node scripts/build-info.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node --disable-warning=ExperimentalWarning packages/server/dist/main.js",
    "test": "vitest run",
    "compare:mainwp": "node scripts/guard.mjs compare:mainwp && tsc -b packages/server && node --disable-warning=ExperimentalWarning packages/server/dist/inventory/compareMainwp.js",
    "test:plugin": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" vitest run -c plugin/vitest.config.ts",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p packages/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && npm run typecheck && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
