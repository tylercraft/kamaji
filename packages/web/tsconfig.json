{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/**/*.test.tsx", "src/**/*.test.ts"],
  "references": [{ "path": "../shared" }]
}
